generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SupportTicket {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @map("user_id") @db.Uuid
  subject   String
  category  String                 @default("GENERAL")
  status    SupportTicketStatus    @default(OPEN)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportTicketMessage[]

  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @map("ticket_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  message   String
  isStaff   Boolean       @default(false) @map("is_staff")
  createdAt DateTime      @default(now()) @map("created_at")
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  name              String
  username          String     @unique
  email             String?    @unique
  phone             String?    @unique
  firebaseUid       String?    @unique @map("firebase_uid")
  passwordHash      String     @map("password_hash")
  status            UserStatus @default(ACTIVE)
  preferredLanguage String     @default("en") @map("preferred_language")
  dateOfBirth       DateTime?  @map("date_of_birth") @db.Date
  gender            Gender?
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  refreshSessions      RefreshSession[]
  roles                UserRoleAssignment[]
  verificationRequests VerificationRequest[]
  driverProfile        DriverProfile?
  guideProfile         GuideProfile?
  ridesAsRider         Ride[]                @relation("RideRider")
  rideEvents           RideEvent[]           @relation("RideEventActor")
  rideAssignments      RideAssignment[]      @relation("RideDriver")
  rideLocations        RideLocation[]        @relation("RideLocationDriver")
  guideRideLocations   RideLocation[]        @relation("RideLocationGuide")
  payments             Payment[]             @relation("PaymentPayer")
  guideAssignments     GuideAssignment[]     @relation("RideGuide")
  notifications        Notification[]
  payoutAccount        DriverPayoutAccount?
  driverPayouts        DriverPayout[]
  supportTickets       SupportTicket[]

  @@map("users")
}

model UserRoleAssignment {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  role               UserRole
  verificationStatus String   @default("PENDING") @map("verification_status")
  createdAt          DateTime @default(now()) @map("created_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model RefreshSession {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  userId         String    @map("user_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  revokedAt      DateTime? @map("revoked_at")
  replacedByHash String?   @map("replaced_by_hash")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_refresh_sessions")
}

model RefreshTokenReuse {
  tokenHash  String   @id @map("token_hash")
  detectedAt DateTime @default(now())

  @@map("auth_refresh_reuse")
}

model VerificationRequest {
  id              String                   @id @default(uuid()) @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  role            UserRole
  status          VerificationStatus       @default(PENDING)
  rejectionReason String?                  @map("rejection_reason")
  submittedAt     DateTime?                @map("submitted_at")
  reviewedAt      DateTime?                @map("reviewed_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps           VerificationStep[]
  documents       VerificationDocument[]
  liveSession     VerificationLiveSession?

  @@index([userId])
  @@index([status])
  @@index([role, status])
  @@map("verification_requests")
}

model VerificationStep {
  id                    String                 @id @default(uuid()) @db.Uuid
  verificationRequestId String                 @map("verification_request_id") @db.Uuid
  step                  VerificationStepType
  status                VerificationStepStatus @default(PENDING)
  completedAt           DateTime?              @map("completed_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  verificationRequest   VerificationRequest    @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@unique([verificationRequestId, step])
  @@index([verificationRequestId])
  @@map("verification_steps")
}

model VerificationDocument {
  id                    String              @id @default(uuid()) @db.Uuid
  verificationRequestId String              @map("verification_request_id") @db.Uuid
  documentType          String              @map("document_type")
  privateObjectKey      String              @map("private_object_key")
  checksum              String?
  expiryDate            DateTime?           @map("expiry_date")
  verificationStatus    VerificationStatus  @default(PENDING) @map("verification_status")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@index([verificationRequestId])
  @@index([verificationStatus])
  @@map("verification_documents")
}

model VerificationLiveSession {
  id                    String                 @id @default(uuid()) @db.Uuid
  verificationRequestId String                 @unique @map("verification_request_id") @db.Uuid
  providerReference     String                 @map("provider_reference")
  status                VerificationStepStatus @default(PENDING)
  startedAt             DateTime?              @map("started_at")
  completedAt           DateTime?              @map("completed_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  verificationRequest   VerificationRequest    @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@map("verification_live_sessions")
}

model DriverProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  bio             String?
  experienceYears Int?      @map("experience_years")
  serviceCity     String?   @map("service_city")
  serviceArea     String?   @map("service_area")
  profileImageKey String?   @map("profile_image_key")
  isAvailable     Boolean   @default(false) @map("is_available")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles        Vehicle[]

  @@index([serviceCity])
  @@index([isAvailable])
  @@map("driver_profiles")
}

model DriverPayoutAccount {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  method                String   @default("BANK")
  accountHolderName     String?  @map("account_holder_name")
  encryptedAccountNumber String? @map("encrypted_account_number")
  accountNumberLast4    String?  @map("account_number_last4")
  ifsc                  String?
  encryptedUpiVpa       String?  @map("encrypted_upi_vpa")
  razorpayContactId     String?  @map("razorpay_contact_id")
  razorpayFundAccountId String?  @map("razorpay_fund_account_id")
  verificationStatus    String   @default("PENDING") @map("verification_status")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
  @@map("driver_payout_accounts")
}

model DriverPayout {
  id                String   @id @default(uuid()) @db.Uuid
  driverId          String   @map("driver_id") @db.Uuid
  rideId            String?  @map("ride_id") @db.Uuid
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("INR") @db.VarChar(3)
  mode              String
  status            String   @default("PENDING")
  provider          String   @default("RAZORPAYX")
  providerPayoutId  String?  @unique @map("provider_payout_id")
  failureReason     String?  @map("failure_reason")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  driver            User     @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt])
  @@index([status, createdAt])
  @@index([rideId])
  @@unique([rideId])
  @@map("driver_payouts")
}

model GuideProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  bio             String?
  experienceYears Int?     @map("experience_years")
  serviceCity     String?  @map("service_city")
  profileImageKey String?  @map("profile_image_key")
  languages       String[] @default([])
  specialties     String[] @default([])
  isAvailable     Boolean  @default(false) @map("is_available")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  guideAssignments GuideAssignment[] @relation("GuideProfileAssignments")

  @@index([serviceCity])
  @@index([isAvailable])
  @@map("guide_profiles")
}

model Vehicle {
  id                 String        @id @default(uuid()) @db.Uuid
  driverProfileId    String        @map("driver_profile_id") @db.Uuid
  make               String
  model              String
  year               Int?
  registrationNumber String        @unique @map("registration_number")
  vehicleType        VehicleType   @default(CAR) @map("vehicle_type")
  seatCount          Int           @map("seat_count")
  color              String?
  imageKey           String?       @map("image_key")
  isActive           Boolean       @default(true) @map("is_active")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  driverProfile      DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@index([driverProfileId])
  @@index([isActive])
  @@map("vehicles")
}

model Ride {
  id                 String            @id @default(uuid()) @db.Uuid
  riderId            String            @map("rider_id") @db.Uuid
  pickupAddress      String            @map("pickup_address")
  pickupLatitude     Decimal           @map("pickup_latitude") @db.Decimal(10, 7)
  pickupLongitude    Decimal           @map("pickup_longitude") @db.Decimal(10, 7)
  dropoffAddress     String            @map("dropoff_address")
  dropoffLatitude    Decimal           @map("dropoff_latitude") @db.Decimal(10, 7)
  dropoffLongitude   Decimal           @map("dropoff_longitude") @db.Decimal(10, 7)
  serviceType        String            @default("RIDE_ONLY") @map("service_type")
  purpose            String?
  paymentMethod      String            @default("RAZORPAY") @map("payment_method")
  scheduledAt        DateTime?         @map("scheduled_at")
  status             RideStatus        @default(REQUESTED)
  notes              String?
  cancelledAt        DateTime?         @map("cancelled_at")
  cancellationReason String?           @map("cancellation_reason")
  completedAt        DateTime?         @map("completed_at")
  fareAmount         Decimal?          @map("fare_amount") @db.Decimal(12, 2)
  fareCurrency       String            @default("INR") @map("fare_currency") @db.VarChar(3)
  fareBreakdown      Json?             @map("fare_breakdown")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  rider              User              @relation("RideRider", fields: [riderId], references: [id], onDelete: Cascade)
  assignments        RideAssignment[]
  guideAssignments   GuideAssignment[]
  events             RideEvent[]
  locations          RideLocation[]
  payment            Payment?
  destinations       RideDestination[]

  @@index([riderId, createdAt])
  @@index([status])
  @@index([scheduledAt])
  @@index([serviceType, status])
  @@map("rides")
}


model RideDestination {
  id          String   @id @default(uuid()) @db.Uuid
  rideId      String   @map("ride_id") @db.Uuid
  sequence    Int
  name        String
  address     String?
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  createdAt   DateTime @default(now()) @map("created_at")
  ride        Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([rideId, sequence])
  @@index([rideId, sequence])
  @@map("ride_destinations")
}

model RideAssignment {
  id         String               @id @default(uuid()) @db.Uuid
  rideId     String               @map("ride_id") @db.Uuid
  driverId   String               @map("driver_id") @db.Uuid
  status     RideAssignmentStatus @default(OFFERED)
  assignedAt DateTime             @default(now()) @map("assigned_at")
  acceptedAt DateTime?            @map("accepted_at")
  rejectedAt DateTime?            @map("rejected_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  ride       Ride                 @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver     User                 @relation("RideDriver", fields: [driverId], references: [id], onDelete: Cascade)

  @@index([rideId, status])
  @@index([driverId, status])
  @@map("ride_assignments")
}

model GuideAssignment {
  id         String               @id @default(uuid()) @db.Uuid
  rideId     String               @map("ride_id") @db.Uuid
  guideId    String               @map("guide_id") @db.Uuid
  status     RideAssignmentStatus @default(OFFERED)
  assignedAt DateTime             @default(now()) @map("assigned_at")
  acceptedAt DateTime?            @map("accepted_at")
  rejectedAt DateTime?            @map("rejected_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  ride         Ride         @relation(fields: [rideId], references: [id], onDelete: Cascade)
  guide        User         @relation("RideGuide", fields: [guideId], references: [id], onDelete: Cascade, map: "guide_assignments_guide_id_user_fkey")
  guideProfile GuideProfile @relation("GuideProfileAssignments", fields: [guideId], references: [userId], onDelete: Cascade, map: "guide_assignments_guide_id_profile_fkey")

  @@unique([rideId, guideId])
  @@index([rideId, status])
  @@index([guideId, status])
  @@map("guide_assignments")
}

model RideEvent {
  id          String        @id @default(uuid()) @db.Uuid
  rideId      String        @map("ride_id") @db.Uuid
  actorUserId String?       @map("actor_user_id") @db.Uuid
  type        RideEventType
  payload     Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  ride        Ride          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  actor       User?         @relation("RideEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([rideId, createdAt])
  @@map("ride_events")
}

model RideLocation {
  id         String   @id @default(uuid()) @db.Uuid
  rideId     String   @map("ride_id") @db.Uuid
  driverId   String?  @map("driver_id") @db.Uuid
  guideId    String?  @map("guide_id") @db.Uuid
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  accuracy   Decimal? @db.Decimal(10, 2)
  recordedAt DateTime @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")
  ride       Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver     User?    @relation("RideLocationDriver", fields: [driverId], references: [id], onDelete: SetNull)
  guide      User?    @relation("RideLocationGuide", fields: [guideId], references: [id], onDelete: SetNull)

  @@index([rideId, recordedAt])
  @@map("ride_locations")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  rideId            String        @unique @map("ride_id") @db.Uuid
  payerId           String        @map("payer_id") @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR") @db.VarChar(3)
  provider          String
  providerPaymentId String?       @unique @map("provider_payment_id")
  status            PaymentStatus @default(PENDING)
  metadata          Json?
  paidAt            DateTime?     @map("paid_at")
  failedAt          DateTime?     @map("failed_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  ride              Ride          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  payer             User          @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  @@index([payerId, createdAt])
  @@index([status])
  @@map("payments")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  amount           Decimal      @db.Decimal(12, 2)
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @unique @map("provider_refund_id")
  reason           String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([status])
  @@map("refunds")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model TrustedContact {
  id            String                      @id @default(uuid()) @db.Uuid
  ownerId       String                      @map("owner_id") @db.Uuid
  inviteeUserId String?                     @map("invitee_user_id") @db.Uuid
  name          String
  phone         String
  consentStatus TrustedContactConsentStatus @default(PENDING) @map("consent_status")
  createdAt     DateTime                    @default(now()) @map("created_at")
  updatedAt     DateTime                    @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([ownerId, consentStatus])
  @@index([inviteeUserId])
  @@map("trusted_contacts")
}

model SharedTrip {
  id        String    @id @default(uuid()) @db.Uuid
  rideId    String    @map("ride_id") @db.Uuid
  contactId String    @map("contact_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([rideId])
  @@index([contactId, expiresAt])
  @@map("shared_trips")
}

model EmergencyIncident {
  id                String                 @id @default(uuid()) @db.Uuid
  riderId           String                 @map("rider_id") @db.Uuid
  rideId            String?                @map("ride_id") @db.Uuid
  category          String
  state             EmergencyIncidentState @default(TRIGGERED)
  triggerSource     String                 @map("trigger_source")
  locationSnapshot  Json?                  @map("location_snapshot")
  heartbeatSnapshot Json?                  @map("heartbeat_snapshot")
  createdAt         DateTime               @default(now()) @map("created_at")
  acknowledgedAt    DateTime?              @map("acknowledged_at")
  escalatedAt       DateTime?              @map("escalated_at")
  resolvedAt        DateTime?              @map("resolved_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@index([riderId, createdAt])
  @@index([rideId])
  @@index([state, createdAt])
  @@map("emergency_incidents")
}

model EmergencyEvent {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  type       String
  payload    Json?
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([incidentId, occurredAt])
  @@map("emergency_events")
}

model EmergencyResponder {
  id          String    @id @default(uuid()) @db.Uuid
  incidentId  String    @map("incident_id") @db.Uuid
  responderId String    @map("responder_id") @db.Uuid
  status      String
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  arrivedAt   DateTime?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([incidentId, status])
  @@index([responderId, status])
  @@map("emergency_responders")
}

model SavedPlace {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  address   String
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  placeId   String?  @map("place_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("saved_places")
}

enum VehicleType {
  CAR
  SUV
  SEDAN
  HATCHBACK
  VAN
  BUS
  OTHER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
  DELETED
}

enum UserRole {
  RIDER
  DRIVER
  GUIDE
  ADMIN
}

enum VerificationStatus {
  PENDING
  UNDER_VERIFICATION
  VERIFIED
  REJECTED
  RESUBMITTED
  SUSPENDED
  BLOCKED
}

enum VerificationStepType {
  PROFILE
  DOCUMENTS
  LIVE_SESSION
  REVIEW
}

enum VerificationStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum RideStatus {
  REQUESTED
  SEARCHING
  ASSIGNED
  DRIVER_ARRIVING
  DRIVER_ARRIVED
  IN_PROGRESS
  NEAR_DESTINATION
  INTERRUPTED
  COMPLETED
  CANCELLED
}

enum RideAssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum RideEventType {
  CREATED
  SEARCH_STARTED
  DRIVER_ASSIGNED
  DRIVER_ACCEPTED
  DRIVER_REJECTED
  DRIVER_ARRIVING
  DRIVER_ARRIVED
  RIDE_STARTED
  RIDE_COMPLETED
  NEAR_DESTINATION
  CANCELLED
  LOCATION_RECORDED
  INTERRUPTED
  RECORDING_CONSENT
  RECOVERY_STARTED
  RECOVERY_ASSIGNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  RIDE_UPDATE
  PAYMENT_UPDATE
  VERIFICATION_UPDATE
  SYSTEM
  SECURITY
}

enum TrustedContactConsentStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum EmergencyIncidentState {
  TRIGGERED
  ACKNOWLEDGED
  RESPONDER_ASSIGNED
  RESPONDER_EN_ROUTE
  RESPONDER_ARRIVED
  ESCALATED
  RESOLVED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}


enum Gender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}
